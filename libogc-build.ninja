  ldflags = $ldflags -sdata 0 -sdata2 0 -r1 -lcf $
      build/GAFE01_00/foresta/ldscript.lcf -m _prolog -strip_partial


build post-link: phony
build build/GAFE01_00/static.dol: elf2dol build/GAFE01_00/static.elf | $
    build/tools/dtk || post-link
# Generate REL(s)
rule makerel
  command = build/tools/dtk rel make -w -c $config $names @libs/libogc_rel0.rsp
  description = REL
  rspfile = $rspfile
  rspfile_content = $in_newline
rule compressrel
  command = build/tools/dtk yaz0 compress $in -o $out
  description = Compress REL
build build/GAFE01_00/foresta/foresta.rel: makerel $
    build/GAFE01_00/static.elf build/GAFE01_00/foresta/foresta.plf | $
    build/tools/dtk config/GAFE01_00/config.yml || post-link
  config = config/GAFE01_00/config.yml
  rspfile = build/GAFE01_00/rel0.rsp
  names = -n static -n foresta
build build/GAFE01_00/foresta/foresta.rel.szs: compressrel $
    build/GAFE01_00/foresta/foresta.rel | build/tools/dtk || post-link

build post-build: phony
# Build all source files
