    build/GAFE01_00/src/data/field/bg/acre/rom_uranai/rom_uranai.o $
    build/GAFE01_00/src/data/item/wall_list.o $
    build/GAFE01_00/src/data/item/wall_price.o

# Build all source files with a host compiler
build all_source_host: phony

# Check hash
rule check
  command = echo "Skipping checksum" && touch $out
  description = CHECK $in
build build/GAFE01_00/ok: check config/GAFE01_00/build.sha1 | $
    build/tools/dtk build/GAFE01_00/static.dol $
    build/GAFE01_00/foresta/foresta.rel || post-build

# Calculate progress
rule progress
  command = $python configure.py $configure_args progress
  description = PROGRESS
build build/GAFE01_00/progress.json: progress | build/GAFE01_00/ok $
    configure.py tools/project.py build/GAFE01_00/report.json || post-build
# Generate progress report
rule report
  command = build/tools/objdiff-cli report generate -o $out
  description = REPORT
build build/GAFE01_00/report.json: report | build/tools/objdiff-cli $
    all_source || post-build
# Check for mismatching symbols
rule dol_diff
  command = build/tools/dtk -L error dol diff $in
  description = DIFF build/GAFE01_00/static.elf
build dol_diff: dol_diff config/GAFE01_00/config.yml $
    build/GAFE01_00/static.elf
build diff: phony dol_diff

# Apply symbols from linked ELF
rule dol_apply
  command = build/tools/dtk dol apply $in
  description = APPLY build/GAFE01_00/static.elf
build dol_apply: dol_apply config/GAFE01_00/config.yml $
    build/GAFE01_00/static.elf | build/GAFE01_00/ok
build apply: phony dol_apply

# Split DOL into relocatable objects
rule split
  command = build/tools/dtk dol split $in $out_dir
  description = SPLIT $in
  depfile = $out_dir/dep
  deps = gcc
build build/GAFE01_00/config.json: split config/GAFE01_00/config.yml | $
    build/tools/dtk
  out_dir = build/GAFE01_00

# Reconfigure on change
rule configure
  command = $python configure.py $configure_args
  description = RUN configure.py
  generator = 1
build build.ninja: configure | build/GAFE01_00/config.json configure.py $
    tools/project.py tools/ninja_syntax.py

