    build/compilers build/tools/wibo build/tools/sjiswrap.exe $
    tools/transform_dep.py || pre-compile
  mw_version = GC/1.3.2
  cflags = -nodefaults -proc gekko -align powerpc -enum int -multibyte $
      -char unsigned -fp hardware -Cpp_exceptions off -pragma "cats off" $
      -pragma "warn_notinlined off" -maxerrors 1 -nosyspath -i include -i $
      include/dolphin -i include/libc -i src/static/dolphin -i $
      build/GAFE01_00/include -DVERSION=0 -sym on -DDEBUG=0 -DNDEBUG -d $
      _LANGUAGE_C -d F3DEX_GBI_2 -d MUST_MATCH -O4,s -sdata 0 -sdata2 0 -d $
      IS_REL -requireprotos -sym on -lang=c
  basedir = build/GAFE01_00/src
  basefile = build/GAFE01_00/src/THA_GA
build build/GAFE01_00/src/THA_GA.ctx: decompctx src/THA_GA.c | $
    tools/decompctx.py

